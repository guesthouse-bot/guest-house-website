{
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/pay-at-close-agents",
      "destination": "/pay-at-close",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/bidding?action=check-deadlines&secret=${CRON_SECRET}",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/bidding?action=hubspot-poll&secret=${CRON_SECRET}",
      "schedule": "0 12 * * *"
    }
  ]
}
